# Copy this file to .env and fill in your values. Never commit .env.
#
# Account identifier: Snowsight > your name (bottom left) > Account > View account details.
# Use the "Account identifier" value, which looks like ORGNAME-ACCOUNTNAME.
SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=YOUR_USER_NAME

# Key-pair authentication: the private key stays on your laptop, outside this project.
# See README / CLAUDE.md for how to create it and register the public key.
SNOWFLAKE_PRIVATE_KEY_FILE=C:/Users/YOU/.snowflake/fleet_rsa_key.p8

# Project objects created by sql/01_setup.sql. No need to change these.
SNOWFLAKE_ROLE=FLEET_ENGINEER
SNOWFLAKE_WAREHOUSE=FLEET_WH
SNOWFLAKE_DATABASE=FLEET_DB
SNOWFLAKE_SCHEMA=BRONZE
